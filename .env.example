# just and Docker Compose load .env from the project root.
# Copy this file to .env and set CONNECTION_MASTER_KEY once.
HTTP_ADDR=127.0.0.1:8080
DATABASE_PATH=./data/onboarding.db
# Permanent content storage; defaults to a content folder beside DATABASE_PATH.
PASSPORT_CONTENT_DIR=./data/content
LOG_LEVEL=info
LOG_FORMAT=console
SHUTDOWN_TIMEOUT=10s
# Exact origins only; no wildcard or trailing slash.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://wayfinder-t1a.eastus2.cloudapp.azure.com

# Stable encryption key for saved LLM and GitHub connections; at least 32 characters.
# Generate once with: openssl rand -hex 32
CONNECTION_MASTER_KEY=
# Extra trusted HTTP/special-network origins, comma-separated.
# Localhost, loopback, and private networks are allowed without this setting.
LLM_ALLOWED_PRIVATE_ORIGINS=
# Optional GitHub read token for private repositories and higher API limits.
GITHUB_TOKEN=
# Optional GitHub OAuth app for browser sign-in in Connections. Set all three.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Register this exact callback URL in your GitHub OAuth app (use HTTPS in production).
GITHUB_OAUTH_REDIRECT_URL=
# Local example (Vite dev server): http://127.0.0.1:5173/api/git-connection/oauth/callback
# Defaults to a wayfinder folder beside DATABASE_PATH.
# FACTORY_WORK_DIR=/absolute/path/wayfinder
# Number of analyses that can run in parallel. Must be a positive integer.
GENERATION_WORKERS=3
# REPOMIX_BIN defaults to the pinned frontend/node_modules executable locally.
# FRONTEND_DIR=../frontend/dist

# Browser-facing origin for MCP sign-in and discovery. Use HTTPS in deployment.
PUBLIC_URL=http://127.0.0.1:5173
