# just backend::run reads environment variables, not this file.
# Defaults below work without configuration. Set overrides in your shell.
HTTP_ADDR=127.0.0.1:8080
DATABASE_PATH=./data/onboarding.db
# Permanent content storage; defaults to a content folder beside DATABASE_PATH.
PASSPORT_CONTENT_DIR=./data/content
LOG_LEVEL=info
LOG_FORMAT=console
SHUTDOWN_TIMEOUT=10s
# Exact origins only; no wildcard or trailing slash.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Stable encryption key for saved LLM and GitHub connections; at least 32 characters.
# Generate once with: openssl rand -hex 32
LLM_MASTER_KEY=
# Exact private/HTTP origins that operators explicitly trust, comma-separated.
# Local API + sidecar: http://127.0.0.1:8317
# Compose API + sidecar: http://llm-proxy:8317
LLM_ALLOWED_PRIVATE_ORIGINS=
# Optional GitHub read token for private repositories and higher API limits.
GITHUB_TOKEN=
# Optional GitHub OAuth app for browser sign-in in Connections. Set all three.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Register this exact callback URL in your GitHub OAuth app (use HTTPS in production).
GITHUB_OAUTH_REDIRECT_URL=
# Local example: http://127.0.0.1:19080/api/git-connection/oauth/callback
FACTORY_WORK_DIR=/Volumes/Workspace/tmp/onboarding-factory
# REPOMIX_BIN defaults to the pinned frontend/node_modules executable locally.
# FRONTEND_DIR=../frontend/dist

# Optional LLM sidecar only; Docker Compose reads these from .env.
# Set a private key before starting: docker compose up --build -d llm-proxy
LLM_SUBSCRIPTION_KEY=
LLM_SUBSCRIPTION_PORT=8317
# Must exist and be writable by container UID 1000; contains Codex OAuth JSON.
LLM_SUBSCRIPTION_AUTH_HOST_DIR=./services/llm-proxy/auth
