# just backend::run reads environment variables, not this file.
# Defaults below work without configuration. Set overrides in your shell.
HTTP_ADDR=127.0.0.1:8080
DATABASE_PATH=./data/onboarding.db
LOG_LEVEL=info
LOG_FORMAT=console
SHUTDOWN_TIMEOUT=10s
# Exact origins only; no wildcard or trailing slash.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
