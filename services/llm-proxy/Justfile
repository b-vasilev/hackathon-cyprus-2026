set dotenv-load := true

default:
    @just --list

build:
    mkdir -p bin
    go build -o bin/llm-proxy ./cmd/llm-proxy

test *ARGS:
    go test ./... {{ARGS}}

fmt:
    go fmt ./...

fmt-check:
    test -z "$(gofmt -l .)"

lint:
    go vet ./...

check: fmt-check lint

audit:
    govulncheck ./...
