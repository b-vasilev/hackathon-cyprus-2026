{
  "name": "wayfinder-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --import tsx --import ./test/setup.mjs --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\"",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "format": "biome format . --write",
    "format:check": "biome format .",
    "lint": "biome lint . && eslint .",
    "generate:api": "openapi-typescript ../backend/internal/api/openapi.json -o src/api.generated.ts && biome format src/api.generated.ts --write"
  },
  "dependencies": {
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/lexend": "^5.3.0",
    "@tanstack/react-query": "^5.105.3",
    "@xyflow/react": "^12.12.1",
    "elkjs": "^0.12.1",
    "lucide-react": "^1.67.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "remark-gfm": "^4.0.1",
    "repomix": "1.18.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.5.0",
    "@eslint/js": "10.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "10.14.0",
    "eslint-import-resolver-typescript": "^4.4.2",
    "eslint-plugin-import-x": "^4.15.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unicorn": "^79.0.0",
    "globals": "^17.14.0",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "^8.3.5"
  }
}
