{
  "name": "wayfinder-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "format": "biome format . --write",
    "format:check": "biome format .",
    "lint": "biome lint . && eslint .",
    "generate:api": "openapi-typescript ../backend/internal/api/openapi.json -o src/api.generated.ts && biome format src/api.generated.ts --write"
  },
  "dependencies": {
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@tanstack/react-query": "^5.104.3",
    "@xyflow/react": "^12.12.0",
    "elkjs": "^0.12.0",
    "lucide-react": "^1.57.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "repomix": "1.18.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.5.0",
    "@eslint/js": "9.39.2",
    "@types/node": "^25.0.9",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "9.39.2",
    "eslint-import-resolver-typescript": "^4.4.2",
    "eslint-plugin-import-x": "^4.15.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unicorn": "^62.0.0",
    "globals": "^17.0.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "^7.3.1"
  }
}
